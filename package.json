{
  "name": "web-llm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:visualize": "vue-tsc -b && vite build --config vite.config.visualize.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:stylelint:fix && pnpm lint:prettier:fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "check": "pnpm lint && pnpm test"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.78",
    "@tailwindcss/vite": "^4.1.4",
    "@vueuse/core": "^13.2.0",
    "@vueuse/integrations": "^13.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.503.0",
    "marked": "^15.0.12",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "reka-ui": "^2.2.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@config-federation/vue": "^1.0.3",
    "@types/node": "^22.15.3",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/tsconfig": "^0.7.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass-embedded": "^1.87.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^4.1.5",
    "vitest-sonar-reporter": "^3.0.0",
    "vue-tsc": "^2.2.8"
  }
}
